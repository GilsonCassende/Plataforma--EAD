# Exemplo de variáveis de ambiente para Plataforma-EAD
# Copie para .env e ajuste conforme ambiente

APP_ENV=development
BASE_URL=/Plataforma-EAD/public
APP_URL=http://localhost/Plataforma-EAD/public

# Database
DB_HOST=localhost
DB_NAME=ead_platform
DB_USER=root
DB_PASS=

# SMTP padrão da aplicação
# O envio principal é sempre SMTP real via PHPMailer.
# Para fallback local em desenvolvimento, use MAIL_FALLBACK_MODE=outbox.
MAIL_FROM=
MAIL_FROM_NAME="Plataforma EAD"

MAIL_FALLBACK_MODE=none

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=tls
SMTP_TIMEOUT=15




# Exemplo Mailtrap (desenvolvimento)
# MAIL_FROM=sandbox@example.mailtrap.io
# SMTP_HOST=sandbox.smtp.mailtrap.io
# SMTP_PORT=2525
# SMTP_USER=seu_usuario_mailtrap
# SMTP_PASS=sua_senha_mailtrap
# SMTP_SECURE=tls

# Exemplo Gmail SMTP (produção)
# MAIL_FROM=seu-email@gmail.com
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=seu-email@gmail.com
# SMTP_PASS=sua_senha_de_app_do_google
# SMTP_SECURE=tls
